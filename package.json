{
  "name": "@giuice/codewiki",
  "version": "0.2.11",
  "description": "Markdown-first CodeWiki framework CLI with human-approved wiki proposals.",
  "type": "module",
  "bin": {
    "codewiki": "dist/bin/codewiki.js"
  },
  "files": [
    "dist/bin/**/*.js",
    "dist/bin/**/*.d.ts",
    "dist/cli.js",
    "dist/cli.d.ts",
    "dist/commands/*.js",
    "dist/commands/*.d.ts",
    "dist/core/**/*.js",
    "dist/core/**/*.d.ts",
    "dist/lib/*.js",
    "dist/lib/*.d.ts",
    "dist/lib/adapters/*.js",
    "dist/lib/adapters/*.d.ts",
    "dist/templates/scaffold.js",
    "dist/templates/scaffold.d.ts",
    "dist/templates/page-templates.js",
    "dist/templates/page-templates.d.ts",
    "dist/templates/skills/**/SKILL.md",
    "dist/templates/hooks/*.sh",
    "dist/templates/claude/agents/*.md",
    "dist/templates/claude/instructions.md",
    "dist/templates/codex/hooks.json",
    "dist/templates/codex/config.toml",
    "dist/templates/codex/hooks/*.sh",
    "dist/templates/codex/agents/*.toml",
    "dist/templates/codex/instructions.md",
    "dist/templates/copilot/hooks/*.json",
    "dist/templates/copilot/hooks/*.sh",
    "dist/templates/copilot/agents/*.agent.md",
    "dist/templates/copilot/instructions.md",
    "dist/templates/opencode/plugins/codewiki.ts",
    "dist/templates/opencode/agents/*.md",
    "dist/templates/opencode/instructions.md",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "postbuild": "mkdir -p dist/templates && cp -r src/templates/. dist/templates/",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && npm run test:unit && node --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "test:unit": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "codewiki",
    "ai",
    "markdown",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  }
}

{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "node .github/hooks/codewiki/pre-tool-use.mjs",
        "powershell": "node .github/hooks/codewiki/pre-tool-use.mjs",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node .github/hooks/codewiki/post-tool-use.mjs",
        "powershell": "node .github/hooks/codewiki/post-tool-use.mjs",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "node .github/hooks/codewiki/agent-stop.mjs",
        "powershell": "node .github/hooks/codewiki/agent-stop.mjs",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "node .github/hooks/codewiki/session-end.mjs",
        "powershell": "node .github/hooks/codewiki/session-end.mjs",
        "cwd": ".",
        "timeoutSec": 30
      }
    ]
  }
}
